# ── MU Innovation Hub — Environment Variables ──────────────────────
# Copy this file to .env and fill in your values.

# Application
APP_NAME=MU Innovation Hub
APP_VERSION=1.0.0
DEBUG=True                # Set False in production (Render)

# Server
PORT=8000                 # Render injects this automatically

# Database (PostgreSQL)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/incubation_db

# JWT Authentication — MUST be >=32 chars when DEBUG=False
SECRET_KEY=change-this-to-a-secure-random-string
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# AI / LLM Provider — set ONE of the keys below
LLM_PROVIDER=openai
OPENAI_API_KEY=
GOOGLE_API_KEY=

# Frontend URL (for CORS) — set to your Vercel domain in production
FRONTEND_URL=http://localhost:3000

