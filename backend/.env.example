# ── MU Innovation Hub — Environment Variables ──────────────────────
# Copy this file to .env and fill in your values.

# Application
APP_NAME=MU Innovation Hub
APP_VERSION=1.0.0
DEBUG=True

# Database (PostgreSQL)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/incubation_db

# JWT Authentication
SECRET_KEY=change-this-to-a-secure-random-string
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# AI / LLM Provider — set ONE of the keys below
LLM_PROVIDER=openai
OPENAI_API_KEY=
GOOGLE_API_KEY=

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:3000
